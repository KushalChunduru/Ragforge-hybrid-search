# "local" = free, runs on-device via sentence-transformers, no API key needed.
# "openai" = text-embedding-3-small via the OpenAI API, requires OPENAI_API_KEY below.
EMBEDDING_PROVIDER=local
# Leave unset to use the provider's default model (BAAI/bge-small-en-v1.5 for local,
# text-embedding-3-small for openai).
EMBEDDING_MODEL=
OPENAI_API_KEY=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
DEDUP_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CHUNK_SIMILARITY_THRESHOLD=0.75
SEMANTIC_CHUNK_MAX_CHARS=1500

CHROMA_PERSIST_DIR=data/index/chroma
CHROMA_COLLECTION=chunks
MANIFEST_PATH=data/index/chunks_manifest.jsonl
BM25_INDEX_PATH=data/index/bm25_index.pkl

RAW_DOCS_DIR=data/raw
PROCESSED_DOCS_DIR=data/processed

# Phase 2: hybrid retrieval
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_TOP_N=20
FINAL_TOP_K=5
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Phase 3: grounded generation. Only "ollama" is implemented -- free, local,
# no API key. Install from https://ollama.com, then `ollama pull llama3.2`.
GENERATION_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
